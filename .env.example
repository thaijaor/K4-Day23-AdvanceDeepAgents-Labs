# Copy this file to .env and fill in YOUR OWN keys. NEVER commit .env (it is in .gitignore).
# The model MUST support tool calling. Copy model names from your provider's documentation.

# --- LLM, option 1: a LangChain provider: LAB_MODEL=<provider>:<model name>, plus that provider's key variable ---
LAB_MODEL=openai:<model name>
OPENAI_API_KEY=
# LAB_MODEL=anthropic:<model name>
# ANTHROPIC_API_KEY=
# LAB_MODEL=google_genai:<model name>
# GOOGLE_API_KEY=

# --- LLM, option 2: any OpenAI-compatible endpoint (OpenRouter, Together, Groq, Azure gateway, local Ollama/vLLM...) ---
# LAB_BASE_URL=https://<endpoint>/v1
# LAB_MODEL=<model name>
# LAB_API_KEY=

# Leave unset unless you need it: some reasoning models reject any non-default temperature.
# LAB_TEMPERATURE=0

# --- Sandbox: Daytona (default). Create a key at https://app.daytona.io ---
DAYTONA_API_KEY=
# No Daytona account or credit left? Run the sandbox in a local Docker container instead (needs Docker; the image must
# contain python3 and bash). The container has no network; the first run pulls the image.
# SANDBOX=docker
# SANDBOX_IMAGE=python:3.12-slim

# --- Web search/fetch through the Exa MCP endpoint. Works without a key but the free tier is rate limited quickly ---
EXA_API_KEY=

# Optional shared LLM pacing across lead and subagents (0 = no local pacing).
# Free-tier Gemini often needs this; set below your model/project RPM quota.
# LAB_REQUESTS_PER_MINUTE=10

# Optional estimated input-token pacing across all agents (0 disables).
# LAB_INPUT_TOKENS_PER_MINUTE=160000

# Optional provider-supported reasoning effort (leave unset if unsupported).
# LAB_REASONING_EFFORT=low

# Optional models for researcher/checker roles; inherit LAB_MODEL when unset.
# They use the same endpoint/key configuration as the lead.
# LAB_RESEARCH_MODEL=<tool-calling model name>
# LAB_CHECKER_MODEL=<tool-calling model name>

# Optional Vertex OAuth using OpenAI SDK (credentials stay on the host).
# LAB_VERTEX_CREDENTIALS=<absolute path to service-account JSON>
# LAB_VERTEX_PROJECT=<Google Cloud project ID>
# LAB_VERTEX_LOCATION=global
# LAB_MODEL=google/<compatible Gemini model>
# LAB_API_KEY can be blank: the adapter refreshes OAuth automatically.
